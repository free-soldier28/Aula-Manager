<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aula.App.ViewModels"
        xmlns:views="using:Aula.App.Views"
        x:Class="Aula.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AulaManager"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <TabControl SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="Device">
            <views:DeviceView />
        </TabItem>
        <TabItem Header="Lighting">
            <views:LightingView />
        </TabItem>
        <TabItem Header="Profiles">
            <views:ProfilesView />
        </TabItem>
    </TabControl>
</Window>
