<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aula.App.ViewModels"
        xmlns:views="using:Aula.App.Views"
        x:Class="Aula.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AulaManager"
        Width="940"
        Height="600"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12 6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="AulaManager" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Update.Status}" VerticalAlignment="Center" Foreground="Gray" />
                <Button Content="Check updates" Command="{Binding Update.CheckCommand}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Device">
                <views:DeviceView DataContext="{Binding Device}" />
            </TabItem>
            <TabItem Header="Lighting" IsEnabled="{Binding IsDeviceConnected}">
                <views:LightingView DataContext="{Binding Lighting}" />
            </TabItem>
            <TabItem Header="Per-Key" IsEnabled="{Binding IsDeviceConnected}">
                <views:PerKeyView DataContext="{Binding PerKey}" />
            </TabItem>
            <TabItem Header="Profiles" IsEnabled="{Binding IsDeviceConnected}">
                <views:ProfilesView DataContext="{Binding Profiles}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
