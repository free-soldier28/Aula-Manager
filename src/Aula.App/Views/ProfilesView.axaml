<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aula.App.ViewModels"
             x:Class="Aula.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel"
             Padding="16">

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0 12 0 0">
            <Button Content="Save current" Command="{Binding SaveCommand}" Classes="accent" />
            <Button Content="Apply" Command="{Binding ApplyCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="Gray" Margin="8 0 0 0" />
        </StackPanel>

        <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,3*" Margin="0 0 0 8">
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="6" Margin="0 0 0 8">
                <TextBlock Text="New profile name" FontWeight="SemiBold" />
                <TextBox Width="220" HorizontalAlignment="Left"
                         Text="{Binding NewProfileName}" />
            </StackPanel>

            <ListBox Grid.Row="1" Grid.Column="0"
                     ItemsSource="{Binding ProfilesList}"
                     SelectedItem="{Binding SelectedProfile}"
                     Margin="0 0 8 0" />
        </Grid>
    </DockPanel>
</UserControl>
